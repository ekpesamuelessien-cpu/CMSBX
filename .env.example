APP_NAME="Campaign Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://clientdomain.com
DEPLOYMENT_MODE=self_hosted
INSTALLER_ENABLED=true
CAMPAIGN_PORTAL_API_BASE=https://campaignmanager.ng/api/v2
CAMPAIGN_PORTAL_DIRECTORY_BASE=https://campaignmanager.ng/api
CAMPAIGN_PORTAL_WEB_BASE=https://campaignmanager.ng
CAMPAIGN_PORTAL_SMS_BASE_URL=https://campaignmanager.ng/api/core/v1
CAMPAIGN_MODULE_SMS=false
SMS_MAX_BATCH_RECIPIENTS=0
SMS_LARGE_BATCH_WARNING=5000
SMS_MESSAGE_MAX_CHARACTERS=10000
SMS_MESSAGE_ACK_CHUNK_SIZE=10000
SMS_MAX_MESSAGE_SYNC_PAGES=10000
CAMPAIGN_RELEASE_KEYS_DIR=storage/app/release-keys
CAMPAIGN_RELEASE_PRIVATE_KEY_PATH=storage/app/release-keys/campaign_release_private.pem
CAMPAIGN_RELEASE_PUBLIC_KEY_PATH=storage/app/release-keys/campaign_release_public.pem
RELEASE_SIGNING_PUBLIC_KEY=
RELEASE_SIGNING_PUBLIC_KEY_ID=campaign-manager-release-v1
CAMPAIGN_RELEASE_GITHUB_REPO=joshualion/Campaign-Manager
CAMPAIGN_RELEASE_ALLOWED_GITHUB_REPOS=joshualion/Campaign-Manager
CAMPAIGN_RELEASE_LAST_VERSION=1.0.6
CAMPAIGN_RELEASE_VERSION_STATE_PATH=release-state.json

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Self-hosted default: polling-friendly, no Reverb/WebSocket server required.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Simple installs should use sync unless a queue worker is configured.
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional advanced realtime mode. Leave WEB_SOCKET_AVAILABILITY=false for polling-first self-hosted installs.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
WEB_SOCKET_AVAILABILITY=false
CAMPAIGN_PACKAGE_TYPE=presidential
